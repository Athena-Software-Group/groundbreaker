# --- Database -----------------------------------------------------------
# Local docker-compose Postgres (default). For a zero-dependency demo you may
# instead use SQLite:  DATABASE_URL=sqlite:///./aegis.db
# docker-compose reads POSTGRES_* from this file; keep DATABASE_URL in step with them.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aegis
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@localhost:5432/aegis

# --- Chain data providers ----------------------------------------------
# "fixture" = offline, seeded from the fictional demo case DEMO-2026-001 (no API keys needed)
# "live"    = Etherscan V2 (EVM), TronGrid (TRON), mempool.space (BTC)
PROVIDER_MODE=fixture

# EVM source: auto (Etherscan if a key is set, else Blockscout) | etherscan | blockscout
# Blockscout needs no key and was verified reachable on 19 Oct 2026.
EVM_PROVIDER=auto
# One Etherscan V2 key covers Ethereum, Arbitrum, Base, BSC, Polygon, etc.
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
MEMPOOL_BASE_URL=https://mempool.space/api

# --- Tracing limits ----------------------------------------------------
TRACE_MAX_HOPS=12
TRACE_MAX_FANOUT=25
TRACE_MIN_TAINT_USD=50

# --- Application -------------------------------------------------------
# Every CHANGE_ME must be replaced. With APP_ENV other than "local" the app refuses to start
# while a secret is unset or a placeholder; in local it starts and logs a WARNING.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs the session and CSRF cookies; changing it signs everybody out.
APP_SECRET_KEY=CHANGE_ME
APP_ENV=local
# 1 = the header shows the environment line (env · providers · db); off by default (demo / production screens)
# AEGIS_SHOW_ENV_BADGE=1
# Users sign in with their own accounts: python -m scripts.create_user you@example.com "Your Name" --system-admin
# (the old shared BASIC_AUTH_USER / BASIC_AUTH_PASSWORD are no longer used). The JSON API also
# accepts HTTP Basic with a user's e-mail and password.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Demo team passwords for the fixture "team" section (optional; unset = generated and printed once
# by `python -m scripts.seed_case`). One variable per demo member:
# AEGIS_DEMO_ADMIN_PASSWORD=          case.admin@aegis.example (admin)
# AEGIS_DEMO_INVESTIGATOR_PASSWORD=   mara.lindqvist@kestrel-ridge.example (investigator)
# AEGIS_DEMO_ANALYST_PASSWORD=        analyst@aegis.example (read_only)
# AEGIS_DEMO_EXTERNAL_PASSWORD=       liaison@le-demo.example (external, expires 2027-01-31)
# AEGIS_DEMO_CLIENT_ADMIN_PASSWORD=   admin@northbridge.example (admin)
# AEGIS_DEMO_VIEWER_PASSWORD=         viewer@northbridge.example (read_only)
LOG_LEVEL=INFO
# .docx exports (relative = under the repo; the default is gitignored)
EXPORT_DIR=exports
# Dev-only one-time sign-in link GET /dev/login?token=…&email=…&next=… (headless screenshots).
# Works only with APP_ENV=local AND a token of 32+ characters; each e-mail can use it once per
# server process. Leave it unset everywhere else.
# AEGIS_DEV_LOGIN_TOKEN=

# --- Evidence ----------------------------------------------------------
# Vault for uploaded originals (<case_id>/<uuid>). Absolute path OUTSIDE the repository, ideally an
# encrypted volume; uploads are refused while it is unset. Run the server with TMPDIR on the same
# volume: uploads over 1 MB are spooled to a temp file before they are streamed into the vault.
# AEGIS_VAULT_DIR=/Volumes/aegis-vault/vault
# Where the web UI may reference originals from (os.pathsep-separated, i.e. ':' on macOS/Linux), per
# case: a plain directory allows <dir>/<case reference>/ (spelled exactly so on disk, and not the same
# directory as another case's) for cases seeded or opened by a system admin; REFERENCE=<dir> allows
# <dir> for that one case, and is the only way for a case opened by a can_create_cases account. Referenced files are hashed read-only and never copied; the repository, the
# vault and symlinked files are always refused.
# AEGIS_EVIDENCE_ROOTS=/Volumes/aegis-vault/intake:DEMO-2026-001=/Volumes/aegis-vault/demo-originals
AEGIS_MAX_UPLOAD_MB=200

# --- Case assistant (app/ai) -------------------------------------------
# OpenAI-compatible client; default = Hugging Face Inference Router, provider pinned
# by the model suffix (":deepinfra" -> third-party inference provider DeepInfra). README "Case assistant".
# No token = rule-based answers and summaries only (labelled "rule-based (AI not configured)").
# What is sent depends on each case's AI mode (off | redacted | full); see docs/data-handling.md §6.1.
# hf_router | hf_endpoint (dedicated HF Inference Endpoint: base URL = endpoint URL + /v1) | anthropic | none
AEGIS_LLM_PROVIDER=hf_router
AEGIS_LLM_BASE_URL=https://router.huggingface.co/v1
AEGIS_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash:deepinfra
# HF organisation billed for inference (X-HF-Bill-To), e.g. your-hf-org; empty = the token owner's account
AEGIS_HF_BILL_TO=
# AEGIS_LLM_TIMEOUT=120
# AEGIS_LLM_MAX_TOKENS=6000
# AEGIS_LLM_ALLOW_ANY_HOST=        # 1 = allow base-URL hosts beyond the HF router / endpoints / localhost
# Fine-grained, inference-only runtime token. Leave EMPTY here: keep the value in a file outside
# the repo, e.g. ~/.config/aegis/aegis.env (mode 600). Never commit a value.
HF_INFERENCE_TOKEN=
# admin/write token for model provisioning — never commit a value (the app never reads it)
HF_API_KEY=
# AEGIS_AI_DISABLED=1               # kill switch: rule-based only even when a token is present (CI, demos)
# ANTHROPIC_API_KEY=                # only with AEGIS_LLM_PROVIDER=anthropic

# --- Notifications (app/domain/notify.py) --------------------------------
# In-app notifications always work. E-mail needs SMTP_HOST and SMTP_FROM; Slack needs an https
# webhook. Unconfigured channels are logged as "not_configured". Messages carry the case reference,
# event, amount, short addresses and a link only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=aegis@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SLACK_WEBHOOK_URL=
# Prefix for links in e-mail / Slack (links stay app-relative when unset)
# APP_BASE_URL=https://aegis.example.com

# --- Sender of record (app/domain/sender.py) -------------------------------
# The organisation that writes every new case's letters on behalf of the case's client, and who
# signs them by default. Each case's sender profile starts from these and can be edited per case.
# AEGIS_ORG_NAME=Your Organisation
# AEGIS_SIGNATORY_NAME=Investigations Desk

# --- E-mail desk (app/mail; docs/m365-setup.md) ---------------------------
# Letters are sent from ONE shared case mailbox. Only case admins can press Send; nothing is sent
# while the transport is "none" (letters can still be prepared and downloaded as .eml).
# none | file (local demo: writes .eml files, reads replies from a folder) | graph (Microsoft 365)
# AEGIS_MAIL_TRANSPORT=none
# The shared case mailbox (From and Reply-To of every letter; the inbox replies are read from)
# AEGIS_MAIL_FROM=case-desk@example.com
# From display name; empty = AEGIS_ORG_NAME
# AEGIS_MAIL_FROM_NAME=
# file transport only: absolute paths OUTSIDE the repository (and outside the vault)
# AEGIS_MAIL_OUTBOX_DIR=/abs/path/outside/repo/mail/outbox
# AEGIS_MAIL_INBOX_DIR=/abs/path/outside/repo/mail/inbox
# Read replies from the mailbox (scheduler, "Check mailbox now"); ISO date: ignore mail received before it
# AEGIS_MAIL_INBOUND=off
# AEGIS_MAIL_INBOUND_SINCE=
# AEGIS_MAIL_MAX_MESSAGE_BYTES=2900000
# AEGIS_MAIL_MAX_INBOUND_BYTES=26214400
# AEGIS_MAIL_SEND_PER_HOUR=20
# AEGIS_MAIL_SEND_PER_HOUR_GLOBAL=60
# AEGIS_MAIL_TEST_SENDS_PER_HOUR=5
# AEGIS_MAIL_TIMEOUT=30
# APP_ENV=local + graph: recipients only in these domains (a safety net against real sends in development)
# AEGIS_MAIL_DEV_ALLOWED_DOMAINS=example.com,example.org,example.net,example
# Microsoft Graph (client credentials). Placeholders only: keep real values in a file outside the
# repo, e.g. ~/.config/aegis/aegis.env (mode 600), or Secrets Manager. Never commit a value.
# AEGIS_M365_TENANT_ID=00000000-0000-0000-0000-000000000000
# AEGIS_M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
AEGIS_M365_CLIENT_SECRET=
# AEGIS_M365_CLIENT_CERT_PATH=        # reserved: certificate auth needs the `cryptography` package (not yet a dependency)
# AEGIS_M365_GRAPH_BASE=https://graph.microsoft.com/v1.0
# AEGIS_M365_LOGIN_HOST=https://login.microsoftonline.com
